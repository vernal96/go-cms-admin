{
  "name": "@go-cms/admin",
  "version": "0.10.0",
  "type": "module",
  "workspaces": [
    "packages/admin-taxi",
    "packages/admin-ministry"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run --fileParallelism=false && node --test scripts/check-vite-env.mjs",
    "typecheck": "vue-go-tsc -p tsconfig.json --noEmit",
    "build": "npm run typecheck && vite build",
    "build:app": "vite build --config vite.app.config.ts && vue-go-tsc -p tsconfig.app.json",
    "preview": "vite preview",
    "build:sdk": "vite build --config vite.sdk.config.ts && vue-go-tsc -p tsconfig.sdk.json",
    "prepack": "npm run build:app && npm run build:sdk && node scripts/verify-sdk-package.mjs"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@tinymce/tinymce-vue": "^6.3.0",
    "@types/node": "26.1.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.6",
    "cropperjs": "1.6.2",
    "element-plus": "2.14.3",
    "jsdom": "28.1.0",
    "tinymce": "^8.8.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.11",
    "vue": "3.5.44",
    "vue-go-tsc": "0.2.1",
    "vue-router": "4.6.4"
  },
  "allowScripts": {
    "vue-go-tsc@0.2.1": true
  },
  "exports": {
    ".": {
      "types": "./dist-app/app.d.ts",
      "import": "./dist-app/app.js"
    },
    "./app": {
      "types": "./dist-app/app.d.ts",
      "import": "./dist-app/app.js"
    },
    "./app.css": "./dist-app/app.css",
    "./sdk": {
      "types": "./dist-sdk/types/sdk.d.ts",
      "import": "./dist-sdk/sdk.js"
    },
    "./sdk.css": "./dist-sdk/sdk.css"
  },
  "files": [
    "dist-app",
    "dist-sdk",
    "SDK.md"
  ],
  "peerDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tinymce/tinymce-vue": "^6.3.0",
    "cropperjs": "^1.6.2",
    "element-plus": "^2.14.3",
    "tinymce": "^8.8.2",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "dependencies": {
    "@go-cms/admin-geo-yandex": "github:vernal96/go-cms-admin-geo-yandex#d3625cac7d46c449971bc8c4ba5b15ce094f6a0a"
  }
}
